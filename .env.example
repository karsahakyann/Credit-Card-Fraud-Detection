# Telegram alerts for the demo service (optional).
#
# The demo works without these: alerts always appear in the dashboard's
# in-page inbox. Fill these in to also receive push notifications.
#
#   1. In Telegram, message @BotFather and send /newbot -- it replies with a token
#   2. Message @userinfobot -- it replies with your numeric chat id
#   3. Copy this file to .env and paste both below
#
# .env is gitignored. Never commit real credentials.

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
